# Copy to .env and fill in. Never commit .env.

# --- Binance --------------------------------------------------------------
# Create the key with "Enable Spot Trading" only. Leave withdrawals disabled
# and restrict the key to the droplet's IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional Ed25519 key file (PEM); if set, BINANCE_API_SECRET is not used. Not needed on
# the testnet: a normal HMAC key opens the account stream there (checked 2026-10-06).
BINANCE_PRIVATE_KEY_PATH=
# Prefix of the client order ids the bot creates (letters/digits). Don't change once
# orders exist: it is how the bot recognises its own orders after a restart.
ORDER_ID_PREFIX=bot
# true  -> testnet.binance.vision (fake funds, separate keys)
# false -> real account
BINANCE_TESTNET=true
# true -> run the full loop but never send an order to Binance
DRY_RUN=true

# --- Database -------------------------------------------------------------
# PostgreSQL is external: a connection string is all the app needs. No database
# is created by docker compose. Provider URLs are accepted as pasted
# (postgres://..., ?sslmode=require); they are converted for asyncpg at startup.
#
# The database is not chosen by BINANCE_TESTNET, only by this URL. Startup refuses a mismatch by
# name: BINANCE_TESTNET=false with a name containing "testnet", or BINANCE_TESTNET=true with one
# containing "prod" or "live".
#
# Local development, the Postgres container already running on port 5432:
DATABASE_URL=postgresql+asyncpg://tidewatch_app:changeme@localhost:5432/tidewatch_local
# The app inside docker compose reaches that same container through the host:
#   DATABASE_URL=postgresql+asyncpg://tidewatch_app:changeme@host.docker.internal:5432/tidewatch_local
# Managed database (example shape; use the string your provider gives you):
#   DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# Special characters in the password must be URL-encoded (@ -> %40, / -> %2F).

# Throwaway database for `pytest` only (and for CI). It must never be a database the bot runs on:
# the tests refuse to start if it equals DATABASE_URL. Migrate it with
#   DATABASE_URL=<this url> .venv/bin/alembic upgrade head
TEST_DATABASE_URL=postgresql+asyncpg://tidewatch_app:changeme@localhost:5432/tidewatch_test

# --- Strategy (percentages are fractions: 0.04 = 4%) ----------------------
# Every pair must end in QUOTE_ASSET. USDT is treated as USD in the tax ledger.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
QUOTE_ASSET=USDT
# Dynamic list (ADR-009), off by default: scan the most traded pairs instead of SYMBOLS, refreshed
# hourly. Risk tier = 24h swing: low <= 2.5%, medium <= 6%, high above. Not a forecast of gains.
SYMBOLS_AUTO=false
SYMBOLS_AUTO_COUNT=12
SYMBOLS_AUTO_MIN_VOLUME=5000000
SYMBOLS_AUTO_MAX_RISK=medium
SYMBOLS_AUTO_REFRESH_MINUTES=60
ENTRY_TIMEOUT_DAYS=3
TAKE_PROFIT_PCT=0.04
STOP_LOSS_PCT=0.02
# Gap between the stop trigger and the stop-limit price, so the sell can still fill
STOP_LIMIT_OFFSET_PCT=0.002

# Entry signal. A starting point, NOT a backtested strategy: RSI was oversold within the last
# RSI_LOOKBACK closed candles and the latest close crossed up through the EMA.
SCAN_INTERVAL=1h
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_LOOKBACK=6
EMA_PERIOD=9
# Place the entry this far below the best bid (0 = at the bid, which rests as a maker order)
ENTRY_DISCOUNT_PCT=0
SCAN_EVERY_SECONDS=60

# --- Risk -----------------------------------------------------------------
# Share of the free quote balance used by one trade (0.98 leaves room for rounding).
ALLOCATION_PCT=0.98
MAX_OPEN_POSITIONS=1
MAX_SPREAD_PCT=0.002
DAILY_LOSS_LIMIT_PCT=0.03
KILL_SWITCH_COOLDOWN_HOURS=24

# --- Engine ---------------------------------------------------------------
# How often the engine checks entry timeouts and unprotected positions.
ENGINE_TICK_SECONDS=30
# Liveness for the Docker health check: the engine touches this file every tick, and the check
# fails if it is older than HEARTBEAT_MAX_AGE_SECONDS.
HEARTBEAT_PATH=/tmp/tidewatch-heartbeat
HEARTBEAT_MAX_AGE_SECONDS=180
# Only one engine may run per database. A second one waits this long for the first to stop
# (a deploy overlaps the old and new container for a moment), then exits.
INSTANCE_LOCK_WAIT_SECONDS=600
# Minimum gap between attempts to place a refused exit again
EXIT_RETRY_SECONDS=120

# --- Notifications --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Answer /status and /help sent from that chat. Read-only. Leave false on any machine that shares the
# token with another running bot (a laptop and a server): only one process can poll a token.
TELEGRAM_COMMANDS=false
# The days in the sales report (python -m bot.reports.sales_sheet, /report) are days in this zone.
REPORT_TIMEZONE=America/Guayaquil
# While a position has no stop-loss, repeat the alert this often in minutes (0 = once only)
UNPROTECTED_REMINDER_MINUTES=15

LOG_LEVEL=INFO

# --- Docker ---------------------------------------------------------------
# Used by docker-compose.yml. "no" while testing; "unless-stopped" to run unattended
# (restarts after a crash or a server reboot).
# RESTART_POLICY=unless-stopped
